<resources>
    <style name="Theme.Ares" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The floating quick-ask panel: see-through, over whatever app you're in -->
    <style name="Theme.Ares.Floating">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- The power-down bottom sheet (MainActivity.showPowerSheet) -->
    <style name="Theme.Ares.Sheet" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="AresButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/cyan</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">14dp</item>
    </style>
    <style name="AresInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="WidgetChip">
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
    </style>
</resources>
