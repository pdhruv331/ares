<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_margin="12dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="16dp" android:elevation="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.dhruv.ares.ReactorView android:id="@+id/reactor" android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="ARES"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical" android:layout_gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A.R.E.S" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.3"/>
                <TextView android:id="@+id/heard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="@color/text_user" android:textSize="13sp" android:maxLines="3" android:ellipsize="start" android:text="At your service, sir."/>
            </LinearLayout>
            <ImageView android:id="@+id/expand" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ic_expand"
                android:contentDescription="Open ARES" android:background="?android:attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <TextView android:id="@+id/reply" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone"
            android:textColor="@color/text" android:textSize="15sp" android:lineSpacingMultiplier="1.3" android:maxLines="12" android:scrollbars="vertical" android:textIsSelectable="true"/>
        <LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <TextView android:id="@+id/attach" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone"
            android:background="@drawable/bg_setup" android:padding="10dp" android:textColor="@color/purple" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <EditText android:id="@+id/input" style="@style/AresInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:hint="@string/type_hint" android:imeOptions="actionSend" android:inputType="textCapSentences|textAutoCorrect" android:singleLine="true"/>
            <ImageView android:id="@+id/send" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:padding="12dp"
                android:background="@drawable/bg_round" android:src="@drawable/ic_send" android:contentDescription="Send"/>
            <TextView android:id="@+id/job" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:gravity="center"
                android:background="@drawable/bg_round" android:text="JOB" android:textColor="@color/purple" android:textSize="10sp" android:letterSpacing="0.1"
                android:contentDescription="Make it a job: a worker on your Mac does it in the background"/>
            <ImageView android:id="@+id/mic" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:padding="12dp"
                android:background="@drawable/bg_round" android:src="@drawable/ic_mic" android:contentDescription="Talk"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
