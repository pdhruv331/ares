<?xml version="1.0" encoding="utf-8"?>
<!-- The presence (docs/phone-ui-prompt.md §5): the reactor grows out of the bubble over whatever you're doing, listens, thinks and
     speaks there with small captions and result cards under it, and condenses back into the bubble. The typing row at the bottom
     is for Share → ARES and the keyboard chip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">

    <com.dhruv.ares.ReactorView android:id="@+id/reactor" android:layout_width="150dp" android:layout_height="150dp"
        android:layout_gravity="top|start" android:contentDescription="ARES"/>

    <LinearLayout android:id="@+id/column" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:alpha="0">
        <TextView android:id="@+id/heard" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:textColor="@color/text_user" android:textSize="12sp" android:maxLines="2" android:ellipsize="start" android:visibility="gone"/>
        <TextView android:id="@+id/reply" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center"
            android:textColor="@color/text" android:textSize="14sp" android:lineSpacingMultiplier="1.25" android:maxLines="4" android:ellipsize="end" android:alpha="0.85"
            android:fontFamily="sans-serif" android:visibility="gone"/>
        <HorizontalScrollView android:id="@+id/chipsScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:id="@+id/chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center"/>
        </HorizontalScrollView>
        <ScrollView android:id="@+id/cardsScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:scrollbars="none" android:overScrollMode="never" android:fillViewport="false">
            <LinearLayout android:id="@+id/cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>
        <TextView android:id="@+id/attach" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone"
            android:background="@drawable/bg_setup" android:padding="10dp" android:textColor="@color/purple" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>

    <TextView android:id="@+id/hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal"
        android:textSize="9sp" android:letterSpacing="0.3" android:textColor="#993EE6FF" android:text="HOLD · TALK     TAP · STOP" android:alpha="0"/>

    <LinearLayout android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_margin="12dp" android:background="@drawable/bg_panel" android:orientation="horizontal" android:padding="10dp" android:elevation="12dp" android:visibility="gone">
        <EditText android:id="@+id/input" style="@style/AresInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:hint="@string/type_hint" android:imeOptions="actionSend" android:inputType="textCapSentences|textAutoCorrect" android:singleLine="true"/>
        <ImageView android:id="@+id/send" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:padding="12dp"
            android:background="@drawable/bg_round" android:src="@drawable/ic_send" android:contentDescription="Send"/>
        <TextView android:id="@+id/job" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:gravity="center"
            android:background="@drawable/bg_round" android:text="JOB" android:textColor="@color/purple" android:textSize="10sp" android:letterSpacing="0.1"
            android:contentDescription="Make it a job: a worker on your Mac does it in the background"/>
        <ImageView android:id="@+id/mic" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:padding="12dp"
            android:background="@drawable/bg_round" android:src="@drawable/ic_mic" android:contentDescription="Talk"/>
    </LinearLayout>

    <TextView android:id="@+id/keyboardChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:background="@drawable/bg_chip" android:text="⌨   TYPE" android:textColor="@color/cyan" android:textSize="10sp" android:letterSpacing="0.25" android:alpha="0"/>
</FrameLayout>
