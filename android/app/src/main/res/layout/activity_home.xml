<?xml version="1.0" encoding="utf-8"?>
<!-- The ARES launcher (docs/launcher-prompt.md): the reactor page and the cards page side by side, the dock below, the
     app drawer over everything. The schematic sheet stays behind both pages and drifts with them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <com.dhruv.ares.SchematicView android:id="@+id/schematic" android:layout_width="match_parent" android:layout_height="match_parent"/>

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <com.dhruv.ares.HomePager android:id="@+id/pager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

            <!-- Page 0: the reactor -->
            <FrameLayout android:id="@+id/page0" android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="36dp" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-thin" android:textSize="68sp" android:textColor="#E6FAFF" android:includeFontPadding="false"
                        android:format12Hour="h:mm" android:format24Hour="HH:mm"/>
                    <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:textSize="10sp" android:letterSpacing="0.3" android:textColor="#B33EE6FF"
                        android:format12Hour="EEE dd MMM" android:format24Hour="EEE dd MMM" android:textAllCaps="true"/>
                </LinearLayout>
                <com.dhruv.ares.ReactorView android:id="@+id/reactor" android:layout_width="240dp" android:layout_height="240dp"
                    android:layout_gravity="top|center_horizontal" android:contentDescription="ARES"/>
                <!-- Notification orbs, the call ripples, the meeting ring, the Mac link, the Buds (docs/launcher-v2-prompt.md §5–7) -->
                <com.dhruv.ares.HomeOverlay android:id="@+id/overlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <TextView android:id="@+id/caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="top" android:paddingStart="28dp" android:paddingEnd="28dp" android:gravity="center"
                    android:textSize="12sp" android:textColor="@color/text_user" android:maxLines="3" android:ellipsize="end" android:alpha="0"
                    android:lineSpacingMultiplier="1.1"/>
                <TextView android:id="@+id/hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="6dp"
                    android:textSize="9sp" android:letterSpacing="0.3" android:textColor="#993EE6FF" android:text="HOLD · TALK     TAP · OPEN"/>
            </FrameLayout>

            <!-- Page 1: your board (apps, widgets, cards) -->
            <ScrollView android:id="@+id/page1" android:layout_width="match_parent" android:layout_height="match_parent"
                android:overScrollMode="never" android:scrollbars="none" android:fillViewport="true">
                <!-- Apps, widgets and the ARES cards, arranged by hand (docs/launcher-v2-prompt.md §9) -->
                <com.dhruv.ares.HomeGrid android:id="@+id/cards" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="18dp" android:paddingBottom="24dp"/>
            </ScrollView>
        </com.dhruv.ares.HomePager>

        <!-- The dock: page dots, five apps, the APPS handle; an upward swipe here opens the drawer too -->
        <com.dhruv.ares.HomePager android:id="@+id/bottom" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                    android:textSize="8sp" android:letterSpacing="0.6" android:textColor="@color/cyan" android:text="● ○"/>
                <LinearLayout android:id="@+id/dock" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp"/>
                <TextView android:id="@+id/handle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                    android:paddingTop="8dp" android:paddingBottom="8dp" android:textSize="9sp" android:letterSpacing="0.35" android:textColor="#993EE6FF"
                    android:text="︿\nAPPS" android:lineSpacingMultiplier="0.9"/>
            </LinearLayout>
        </com.dhruv.ares.HomePager>
    </LinearLayout>

    <!-- The app drawer: paged like One UI's Apps screen (DrawerPages.kt); the pages, dots and folder sheet are built in code -->
    <LinearLayout android:id="@+id/drawer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/bg" android:visibility="gone" android:clickable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="18dp" android:layout_marginEnd="18dp"
            android:layout_marginTop="14dp" android:background="@drawable/bg_search" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="16dp" android:paddingEnd="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌕" android:textColor="@color/cyan" android:textSize="18sp"/>
            <EditText android:id="@+id/search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="10dp" android:background="@null" android:hint="SEARCH OR ASK" android:textSize="14sp"
                android:textColor="@color/text" android:textColorHint="@color/muted" android:singleLine="true" android:imeOptions="actionGo"
                android:inputType="text|textNoSuggestions"/>
            <TextView android:id="@+id/drawerMenu" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="⋮"
                android:textColor="@color/cyan" android:textSize="20sp" android:contentDescription="Drawer options" android:background="?android:attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>
        <com.dhruv.ares.DragFrame android:id="@+id/dragFrame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
            <FrameLayout android:id="@+id/pagesBox" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <ScrollView android:id="@+id/searchScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"
                android:scrollbars="none" android:overScrollMode="never">
                <LinearLayout android:id="@+id/searchBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="24dp"/>
            </ScrollView>
            <View android:id="@+id/edgeLeft" android:layout_width="36dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="@drawable/edge_glow_left" android:alpha="0"/>
            <View android:id="@+id/edgeRight" android:layout_width="36dp" android:layout_height="match_parent" android:layout_gravity="end" android:background="@drawable/edge_glow_right" android:alpha="0"/>
            <View android:id="@+id/scan" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cyan" android:alpha="0"/>
        </com.dhruv.ares.DragFrame>
        <FrameLayout android:id="@+id/dotsBox" android:layout_width="match_parent" android:layout_height="22dp"/>
        <TextView android:id="@+id/drawerHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:paddingTop="6dp" android:paddingBottom="10dp" android:textSize="9sp" android:letterSpacing="0.35" android:textColor="#993EE6FF"
            android:text="HOME\n﹀" android:lineSpacingMultiplier="0.9"/>
    </LinearLayout>
</FrameLayout>
