<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <!-- The list: every job on the Mac, newest first, and a box to start a new one -->
    <LinearLayout android:id="@+id/listPane" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/back" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹"
                android:textColor="@color/cyan" android:textSize="24sp" android:contentDescription="Back" android:background="?android:attr/selectableItemBackgroundBorderless"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp"
                android:text="WORK" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp" android:letterSpacing="0.3"/>
            <TextView android:id="@+id/gallery" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_chip"
                android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="GALLERY" android:textColor="@color/cyan" android:textSize="11sp" android:letterSpacing="0.12"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_input" android:padding="10dp" android:layout_marginBottom="12dp">
            <EditText android:id="@+id/newText" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null"
                android:hint="A new job: research, compare, write, make slides…" android:textColor="@color/text" android:textColorHint="@color/muted"
                android:textSize="15sp" android:minLines="2" android:maxLines="6" android:gravity="top" android:inputType="textCapSentences|textAutoCorrect|textMultiLine"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                <TextView android:id="@+id/attach" android:layout_width="44dp" android:layout_height="40dp" android:background="@drawable/bg_chip" android:gravity="center"
                    android:text="📎" android:textSize="16sp" android:contentDescription="Attach files"/>
                <ImageView android:id="@+id/mic" android:layout_width="44dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:background="@drawable/bg_chip"
                    android:padding="9dp" android:src="@drawable/ic_mic" android:contentDescription="Dictate"/>
                <TextView android:id="@+id/files" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                    android:textColor="@color/purple" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
                <TextView android:id="@+id/start" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/bg_button"
                    android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="START" android:textColor="@color/cyan" android:textSize="12sp" android:letterSpacing="0.15"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/jobs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp"/>
        </ScrollView>
    </LinearLayout>

    <!-- One job, rendered by the Mac (the same mobile view as the web app), in place of the list -->
    <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:background="@color/bg"/>
</FrameLayout>
