<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <!-- Pairing -->
    <LinearLayout android:id="@+id/pair" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:padding="24dp" android:visibility="gone">
        <ImageView android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="center" android:src="@drawable/reactor" android:layout_marginBottom="24dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="PAIR WITH YOUR MAC" android:textColor="@color/cyan" android:textSize="16sp" android:letterSpacing="0.2" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:layout_marginBottom="20dp"
            android:text="With Tailscale on, choose Pair a Phone… in the ARES menu on your Mac and enter the code it shows."
            android:textColor="@color/muted" android:textSize="13sp" android:lineSpacingMultiplier="1.3"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAC ADDRESS" android:textColor="@color/muted" android:textSize="10sp" android:letterSpacing="0.2" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/url" style="@style/AresInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textUri" android:singleLine="true" android:textSize="13sp"/>
        <EditText android:id="@+id/code" style="@style/AresInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:hint="000000" android:inputType="number" android:maxLength="6" android:gravity="center" android:textSize="28sp" android:letterSpacing="0.5" android:padding="14dp"/>
        <TextView android:id="@+id/pairBtn" style="@style/AresButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="PAIR"/>
        <TextView android:id="@+id/pairErr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center"
            android:textColor="@color/amber" android:textSize="13sp"/>
    </LinearLayout>

    <!-- The app: the schematic sheet behind, the reactor centred in the stage, one-line captions, COMMS as a drawer -->
    <FrameLayout android:id="@+id/app" android:layout_width="match_parent" android:layout_height="match_parent">
        <com.dhruv.ares.SchematicView android:id="@+id/schematic" android:layout_width="match_parent" android:layout_height="match_parent"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="6dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
                <FrameLayout android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot" android:layout_marginEnd="10dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true"
                    android:text="A.R.E.S" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.3"/>
                <!-- Power down the Mac's ARES (a bottom sheet with a slider); hidden while she's off -->
                <ImageView android:id="@+id/powerBtn" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:padding="7dp"
                    android:src="@drawable/ic_power" android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Power down the Mac's ARES" android:visibility="gone"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <TextView android:id="@+id/workBtn" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_chip" android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp"
                    android:text="WORK" android:textColor="@color/cyan" android:textSize="9sp" android:letterSpacing="0.15" android:contentDescription="Work: your background jobs"/>
                <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp"
                    android:textColor="@color/status" android:textSize="9sp" android:letterSpacing="0.15"/>
                <ImageView android:id="@+id/menu" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp"
                    android:src="@drawable/ic_menu" android:contentDescription="Menu" android:background="?android:attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <TextView android:id="@+id/setup" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
                android:background="@drawable/bg_setup" android:padding="10dp" android:textColor="@color/purple" android:textSize="12sp"/>
            <!-- Scheduled standby / wake (a power routine on the Mac) -->
            <TextView android:id="@+id/schedChip" android:layout_width="wrap_content" android:layout_height="26dp" android:layout_gravity="center_horizontal" android:visibility="gone"
                android:background="@drawable/bg_chip_blue" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:textColor="@color/blue" android:textSize="9sp" android:letterSpacing="0.12" android:fontFamily="monospace"/>

            <!-- The stage: the reactor (or the 3D brain), one line of caption at its foot -->
            <FrameLayout android:id="@+id/stage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <com.dhruv.ares.ReactorView android:id="@+id/reactorFallback" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"
                    android:layout_marginTop="36dp" android:layout_marginBottom="36dp" android:contentDescription="ARES. Tap to stop her talking."/>
                <com.dhruv.ares.BrainView android:id="@+id/reactor" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:contentDescription="ARES. Tap to stop her talking; tap a job's orb to open it."/>
                <TextView android:id="@+id/caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="14dp" android:gravity="center" android:alpha="0"
                    android:textColor="@color/cyan" android:textSize="10.5sp" android:letterSpacing="0.06" android:lineSpacingMultiplier="1.35" android:maxLines="2" android:fontFamily="monospace"
                    android:shadowColor="#663EE6FF" android:shadowRadius="10" android:shadowDx="0" android:shadowDy="0"/>
            </FrameLayout>

            <TextView android:id="@+id/stateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="8dp"
                android:gravity="center" android:textColor="@color/cyan" android:textSize="9sp" android:letterSpacing="0.3" android:alpha="0.85" android:maxLines="2" android:lineSpacingMultiplier="1.3"/>

            <!-- Typing, behind the keyboard button -->
            <LinearLayout android:id="@+id/inputRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone">
                <EditText android:id="@+id/input" style="@style/AresInput" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:textSize="14sp"
                    android:hint="@string/type_hint" android:imeOptions="actionSend" android:inputType="textCapSentences|textAutoCorrect" android:singleLine="true"/>
                <ImageView android:id="@+id/send" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:padding="11dp"
                    android:background="@drawable/bg_round" android:src="@drawable/ic_send" android:contentDescription="Send"/>
            </LinearLayout>

            <!-- Controls: a small keyboard ring and a short talk pill -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/kbBtn" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" android:padding="11dp" android:alpha="0.8"
                    android:background="@drawable/bg_round" android:src="@drawable/ic_keyboard" android:contentDescription="Type instead"/>
                <TextView android:id="@+id/talk" android:layout_width="190dp" android:layout_height="40dp" android:background="@drawable/bg_pill"
                    android:gravity="center" android:text="◉   TAP TO TALK" android:textColor="@color/cyan" android:textSize="10sp" android:letterSpacing="0.2" android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- The COMMS handle -->
            <TextView android:id="@+id/commsHandle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="4dp"
                android:gravity="center" android:text="︿\nCOMMS" android:textColor="@color/cyan" android:textSize="9sp" android:letterSpacing="0.35" android:alpha="0.6" android:lineSpacingMultiplier="0.9"/>
        </LinearLayout>

        <!-- COMMS: the conversation, slid up from the bottom like the Mac's drawer -->
        <FrameLayout android:id="@+id/drawer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="invisible">
            <View android:id="@+id/drawerScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#6602060A"/>
            <LinearLayout android:id="@+id/drawerPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_gravity="bottom" android:orientation="vertical"
                android:background="@drawable/bg_drawer" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp">
                <TextView android:id="@+id/drawerClose" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="2dp"
                    android:text="﹀" android:textColor="@color/cyan" android:textSize="13sp" android:alpha="0.7"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="⟨ COMMS ⟩" android:textColor="@color/cyan" android:textSize="10sp" android:letterSpacing="0.3"/>
                    <TextView android:id="@+id/drawerClear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLEAR" android:textColor="@color/muted" android:textSize="9sp" android:letterSpacing="0.2" android:padding="2dp"/>
                </LinearLayout>
                <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fadingEdgeLength="24dp" android:requiresFadingEdge="vertical">
                    <LinearLayout android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="12dp"/>
                </ScrollView>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
