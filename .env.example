# Copy to .env and fill in. Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# "Katherine" — articulate, refined British. Alternatives: XEoBW4iDmiawQP72xnAF (Evelyn, dry wit), xru6qZB94sJdkyqP12qN (James, butler)
ELEVENLABS_VOICE_ID=NTqGiNK8P02i66yY2GOH
# eleven_v3 (most expressive, handles humour), eleven_multilingual_v2 (natural), eleven_flash_v2_5 (fastest)
ELEVENLABS_MODEL=eleven_v3
# Speaking speed, 0.7 (slower) to 1.2 (faster). 1.0 = the voice's natural pace.
ELEVENLABS_SPEED=1.1

# ARES brain runs on Claude Code (your Claude subscription). sonnet = fast, opus = smarter but slower
ARES_CLAUDE_MODEL=sonnet

# Wake phrases, comma-separated. Multi-word phrases work anywhere; a single word (like "ares")
# only counts at the start of what you say, so just mentioning ARES won't wake her.
ARES_WAKE_PHRASES=hey ares, ok ares, ares

# Voice ID strictness (0-1). Leave unset to use the value calibrated when you trained it.
# ARES_VOICE_THRESHOLD=0.55

# How long ARES waits after you stop talking before answering (milliseconds). Raise it if she
# cuts you off; lower it for snappier replies. She also waits while the mic still hears sound.
ARES_END_SILENCE_MS=1300

# Always-listening ("ARES, stay awake") switches itself off after this many quiet minutes.
ARES_AWAKE_TIMEOUT_MIN=10

# Max simultaneous ElevenLabs requests (Creator plan = 3)
ELEVENLABS_CONCURRENCY=3

# Work mode (optional; each tool simply isn't offered to workers without its key)
# Unsplash stock photos (free "demo" app: 50 requests/hour): https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Firecrawl page reader, used before Jina Reader when set (free plan: 1,000 credits/month)
FIRECRAWL_API_KEY=
# Later: Notion and Exa MCP servers for workers (see worker-tools.js)
NOTION_TOKEN=
EXA_API_KEY=

# ARES phone line: an ElevenLabs agent on a Twilio number (ids from the ElevenLabs dashboard; not secret)
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Outbound calls ARES may place per day, max length of any call (seconds), and the cap on all calls the line takes a day
ARES_CALLS_PER_DAY=10
ARES_CALL_MAX_SECS=300
ARES_LINE_DAILY_LIMIT=40

# Cloudflare relay (relay/): FCM pushes to the Android app with the Mac off. The secret is shared with the Worker.
ARES_RELAY_URL=
ARES_RELAY_SECRET=

# Backup voice (free, local: Kokoro via sherpa-onnx; model downloaded by scripts/get-voice-model.sh)
# Voice: bf_emma (chosen), bf_isabella, bf_alice, bf_lily. Speed 0.8-1.3.
ARES_LOCAL_VOICE=bf_emma
ARES_LOCAL_SPEED=1.05
# Keep enough ElevenLabs credits for this many phone-agent minutes (agent calls and TTS share one credit pool).
# Below it, ARES's own speech uses the backup voice. ~440 credits per call minute on Creator (121k credits / ~275 min).
ARES_VOICE_RESERVE_MIN=60
ARES_CALL_CREDITS_PER_MIN=440
# Development builds use the backup voice. Set to 1 to test with Katherine (spends credits).
# ARES_DEV_ELEVEN=1

# Voicemails from the Twilio fallback (read-only). Create a Standard API key in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
